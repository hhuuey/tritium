<?xml version="1.0"?>
<package format="3">
  <name>fast_livo_ros2</name>
  <version>0.1.0</version>
  <description>FAST-LIVO2 完整 ROS 2 Jazzy 薄适配器，不编译算法源文件。</description>
  <maintainer email="dev@livoxtech.com">FAST-LIVO2 contributors</maintainer>
  <license>BSD</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>fast_livo_core</depend>
  <depend>rclcpp</depend>
  <depend>rosgraph_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>pcl_conversions</depend>
  <depend>fast_livo_ros2_interfaces</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>yaml-cpp</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
